generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TECH
  STUDENT
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum OrganizationStatus {
  ACTIVE
  BANNED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BanRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id        Int                @id @default(autoincrement())
  name      String
  nit       String             @unique
  status    OrganizationStatus @default(ACTIVE)
  bannedAt  DateTime?
  banReason String?
  createdAt DateTime           @default(now())

  users          User[]
  items          Item[]
  loans          Loan[]
  logs           AuditLog[]
  reports        UserReport[]
  banRequests    AdminBanRequest[]
  accessRequests AccessRequest[]
}

model User {
  id        Int        @id @default(autoincrement())
  email     String
  password  String
  fullName  String
  role      Role       @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  bannedAt  DateTime?
  banReason String?
  banUntil  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  loans           Loan[]
  logs            AuditLog[]   @relation("UserLogs")
  reportsMade     UserReport[] @relation("ReportsMade")
  reportsReceived UserReport[] @relation("ReportsReceived")
  banRequestsMade        AdminBanRequest[] @relation("BanRequestsMade")
  banRequestsTarget      AdminBanRequest[] @relation("BanRequestsTarget")
  banRequestsDecided     AdminBanRequest[] @relation("BanRequestsDecided")
  accessRequestDecisions AccessRequest[]   @relation("AccessRequestDecisions")
  orgRequestDecisions    OrgRequest[]      @relation("OrgRequestDecisions")

  @@unique([email, organizationId])
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  code        String
  description String?
  quantity    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  loans Loan[]
}

model Loan {
  id         Int        @id @default(autoincrement())
  userId     Int
  itemId     Int
  status     LoanStatus @default(ACTIVE)
  loanedAt   DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int?
  entity    String
  entityId  Int?
  createdAt DateTime @default(now())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  user User? @relation("UserLogs", fields: [userId], references: [id])
}

model UserReport {
  id           Int          @id @default(autoincrement())
  userId       Int
  reportedById Int
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  user       User @relation("ReportsReceived", fields: [userId], references: [id])
  reportedBy User @relation("ReportsMade", fields: [reportedById], references: [id])
}

model AdminBanRequest {
  id            Int              @id @default(autoincrement())
  reason        String
  status        BanRequestStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
  decisionNote  String?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  requestedById Int
  requestedBy   User @relation("BanRequestsMade", fields: [requestedById], references: [id])

  targetUserId Int
  targetUser   User @relation("BanRequestsTarget", fields: [targetUserId], references: [id])

  decidedById Int?
  decidedBy   User? @relation("BanRequestsDecided", fields: [decidedById], references: [id])

  @@index([organizationId, status])
  @@index([targetUserId, status])
}

model AccessRequest {
  id        Int           @id @default(autoincrement())
  fullName  String
  email     String
  password  String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  decidedAt DateTime?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  decidedById Int?
  decidedBy   User? @relation("AccessRequestDecisions", fields: [decidedById], references: [id])

  @@index([organizationId, status])
}

model OrgRequest {
  id             Int           @id @default(autoincrement())
  orgName        String
  orgNit         String
  requesterName  String
  requesterEmail String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  decidedAt      DateTime?

  decidedById Int?
  decidedBy   User? @relation("OrgRequestDecisions", fields: [decidedById], references: [id])

  @@index([status])
}
